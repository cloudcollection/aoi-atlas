{
  "manifest_version": 3,
  "name": "AOI Atlas · 多地图采集",
  "version": "2.1.2",
  "minimum_chrome_version": "111",
  "description": "从高德、百度地图收集 AOI 边界，预览并导出 GeoJSON / CSV；腾讯支持地点。保留来源与质量标记，本地保存。",
  "permissions": ["downloads"],
  "host_permissions": [
    "https://gaode.com/*",
    "https://*.gaode.com/*",
    "https://amap.com/*",
    "https://*.amap.com/*",
    "https://map.baidu.com/*",
    "https://map.qq.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    {
      "resources": ["images/aoi-logo.svg"],
      "matches": [
        "https://*.gaode.com/*",
        "https://*.amap.com/*",
        "https://map.baidu.com/*",
        "https://map.qq.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gaode.com/*",
        "https://*.gaode.com/*",
        "https://amap.com/*",
        "https://*.amap.com/*",
        "https://map.baidu.com/*",
        "https://map.qq.com/*"
      ],
      "js": ["core.js", "hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gaode.com/*",
        "https://*.gaode.com/*",
        "https://amap.com/*",
        "https://*.amap.com/*",
        "https://map.baidu.com/*",
        "https://map.qq.com/*"
      ],
      "js": ["core.js", "panel.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
